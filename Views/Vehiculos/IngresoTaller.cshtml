@{
    ViewData["Title"] = "Mantenimiento de vehículos";
    ViewData["HeaderEyebrow"] = "Operación vehicular";
    ViewData["HeaderSubtitle"] = "Registra el ingreso de una unidad y consulta rápidamente su estado.";
}

@section Head {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/vista-vehiculos.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/vista-mantenimientos.css" asp-append-version="true" />
}

<div class="ingreso-taller-page">
<partial name="_PageHeader" />

<!-- ─── Tarjeta 1: Datos del Ingreso a Taller ───────────────────────────── -->
<form id="formIngresoTaller" class="vehiculo-create-form vehiculo-module-form mantenimiento-form" novalidate>

    <section class="cavex-card form-section-card vehiculo-section-card mant-card" id="card1" aria-labelledby="tituloRegistroMantenimiento">
        <div class="mant-section-heading">
            <span class="mant-section-icon" aria-hidden="true"><i class="bi bi-tools"></i></span>
            <div>
                <span class="mant-section-eyebrow">Nuevo registro</span>
                <h2 class="form-section-title" id="tituloRegistroMantenimiento">Registrar ingreso a mantenimiento</h2>
                <p>Captura los datos de la unidad, la persona responsable y el destino del servicio.</p>
            </div>
            <span class="mant-status-badge"><span></span> En mantenimiento</span>
        </div>

        <div class="row g-3">
            <!-- Vehículo -->
            <div class="col-md-6 col-xl-4">
                <label class="form-label" for="mant-idVehDatosGenerales">Vehículo <span class="mant-required" aria-hidden="true">*</span></label>
                <select id="mant-idVehDatosGenerales" name="idVehDatosGenerales" class="form-select" required>
                    <option value="">Seleccione un vehículo</option>
                </select>
                <div class="invalid-feedback">Selecciona un vehículo válido.</div>
            </div>

            <!-- Empleado Responsable -->
            <div class="col-md-6 col-xl-4">
                <label class="form-label" for="mant-idEmpEmpleadoChofer">Empleado responsable <span class="mant-required" aria-hidden="true">*</span></label>
                <select id="mant-idEmpEmpleadoChofer" name="idEmpEmpleadoChofer" class="form-select" required>
                    <option value="">Seleccionar...</option>
                </select>
                <div class="invalid-feedback">Selecciona un empleado responsable.</div>
            </div>

            <!-- Encargado Autorizador -->
            <div class="col-md-6 col-xl-4">
                <label class="form-label" for="mant-idVehCatResponsableServicio">Encargado autorizador <span class="mant-required" aria-hidden="true">*</span></label>
                <select id="mant-idVehCatResponsableServicio" name="idVehCatResponsableServicio" class="form-select" required>
                    <option value="">Seleccionar...</option>
                </select>
                <div class="invalid-feedback">Selecciona el encargado que autorizó el envío.</div>
            </div>

            <!-- Fecha de Generación -->
            <div class="col-md-6 col-xl-3">
                <label class="form-label" for="mant-dteFechaServicio">Fecha de ingreso <span class="mant-required" aria-hidden="true">*</span></label>
                <input type="date" id="mant-dteFechaServicio" name="dteFechaServicio" class="form-control" required />
                <div class="invalid-feedback">Selecciona una fecha válida.</div>
            </div>

            <!-- Tipo de Servicio / Motivo -->
            <div class="col-md-6 col-xl-5">
                <label class="form-label" for="mant-idVehCatTipoServicio">Tipo de servicio / motivo <span class="mant-required" aria-hidden="true">*</span></label>
                <select id="mant-idVehCatTipoServicio" name="idVehCatTipoServicio" class="form-select" required>
                    <option value="">Seleccionar...</option>
                </select>
                <div class="invalid-feedback">Selecciona el tipo de servicio.</div>
            </div>

            <!-- Taller de Destino -->
            <div class="col-md-6 col-xl-4">
                <label class="form-label" for="mant-idVehCatTaller">Taller de destino <span class="mant-required" aria-hidden="true">*</span></label>
                <select id="mant-idVehCatTaller" name="idVehCatTaller" class="form-select" required>
                    <option value="">Seleccionar...</option>
                </select>
                <div class="invalid-feedback">Selecciona el taller.</div>
            </div>

            <!-- Kilometraje Actual -->
            <div class="col-md-6 col-xl-3">
                <label class="form-label" for="mant-decKilometrajeActual">Kilometraje actual <span class="mant-required" aria-hidden="true">*</span></label>
                <div class="input-group">
                    <input type="text" id="mant-decKilometrajeActual" name="decKilometrajeActual" maxlength="15" class="form-control" placeholder="0" required />
                    <span class="input-group-text">km</span>
                </div>
                <div class="invalid-feedback">Captura un kilometraje válido.</div>
            </div>

            <!-- Descripción / Observaciones generales (opcional) -->
            <div class="col-12">
                <div class="d-flex justify-content-between gap-3">
                    <label class="form-label" for="mant-strDescripcion">Observaciones <span class="mant-optional">Opcional</span></label>
                    <span class="mant-character-counter" id="mantDescripcionCounter" aria-live="polite">0/500</span>
                </div>
                <textarea id="mant-strDescripcion" name="strDescripcion" class="form-control" rows="3" maxlength="500" placeholder="Describe brevemente el problema o motivo de ingreso..."></textarea>
            </div>
        </div>
    </section>

    <!-- ─── Switch global: ¿ya concluyó el servicio? ──────────────────────────── -->
    <div class="mant-switch-banner cavex-card">
        <div class="mant-switch-banner__text">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            <span><strong>¿El servicio ya concluyó?</strong><small>Activa esta opción para registrar también el reporte del taller.</small></span>
        </div>
        <label class="mant-toggle" for="switchServicioConcluido">
            <input type="checkbox" id="switchServicioConcluido" role="switch" aria-checked="false" />
            <span class="mant-toggle__track">
                <span class="mant-toggle__thumb"></span>
            </span>
            <span class="mant-toggle__label" id="switchLabel">NO</span>
        </label>
    </div>

    <!-- ─── Tarjeta 2: Reporte de Taller (oculta hasta activar el switch) ─── -->
    <section class="cavex-card form-section-card vehiculo-section-card mant-card" id="card2" style="display: none;" aria-labelledby="tituloReporteTaller">
        <div class="mant-section-heading">
            <span class="mant-section-icon mant-section-icon--teal" aria-hidden="true"><i class="bi bi-receipt"></i></span>
            <div>
                <span class="mant-section-eyebrow">Cierre de servicio</span>
                <h2 class="form-section-title" id="tituloReporteTaller">Reporte de taller</h2>
                <p>Registra los costos, forma de pago y comprobante del servicio concluido.</p>
            </div>
        </div>

        <div class="row g-3">
            <!-- Costos financieros -->
            <div class="col-md-4">
                <label class="form-label" for="mant-mnyCostoManoObra">Mano de Obra ($)</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input type="text" id="mant-mnyCostoManoObra" name="mnyCostoManoObra" class="form-control" placeholder="0.00" value="" disabled />
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="mant-mnyCostoRefacciones">Refacciones ($)</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input type="text" id="mant-mnyCostoRefacciones" name="mnyCostoRefacciones" class="form-control" placeholder="0.00" value="" disabled />
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="mant-mnyCostoTotal">TOTAL GENERAL ($)</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input type="text" id="mant-mnyCostoTotal" class="form-control mant-total-input" placeholder="0.00" value="" readonly disabled />
                </div>
            </div>

            <!-- Forma de pago -->
            <div class="col-md-6">
                <label class="form-label" for="mant-idVehFormaPago">Forma de Pago</label>
                <select id="mant-idVehFormaPago" name="idVehFormaPago" class="form-select" disabled>
                    <option value="">Seleccionar...</option>
                </select>
            </div>

            <!-- Comprobante de pago -->
            <div class="col-md-6">
                <label class="form-label" for="mantComprobanteArchivo">Comprobante de Pago</label>
                <div id="mantComprobanteArea" class="vehiculo-upload-area mant-upload-area mant-upload-area--disabled">
                    <input id="mantComprobanteArchivo" type="file" class="vehiculo-file-input" accept=".pdf,.jpg,.jpeg,.png,.webp" disabled />
                    <input type="hidden" id="mant-strUrlComprobantePago" name="strUrlComprobantePago" value="" />
                    <div id="mantComprobantePrompt" class="vehiculo-upload-prompt">
                        <span class="vehiculo-upload-icon" aria-hidden="true">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
                            </svg>
                        </span>
                        <strong>Subir comprobante</strong>
                        <small>PDF, JPG, PNG, WEBP · máx. 5 MB</small>
                    </div>
                    <div class="vehiculo-file-preview" id="mantFilePreview" style="display:none;">
                        <div class="vehiculo-file-meta">
                            <strong id="mantFileName">Archivo seleccionado</strong>
                            <small id="mantFileSize"></small>
                        </div>
                        <div class="vehiculo-file-actions">
                            <button id="btnQuitarComprobanteMant" type="button" class="btn btn-outline-cavex btn-sm">Quitar</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ─── Barra de acción ────────────────────────────────────────────────── -->
    <div class="form-action-bar vehiculo-action-bar">
        <a class="btn btn-outline-cavex" asp-controller="Vehiculos" asp-action="Index"><i class="bi bi-arrow-left"></i> Volver</a>
        <div class="mant-action-group">
            <button type="button" id="btnLimpiarIngresoTaller" class="btn btn-outline-cavex"><i class="bi bi-eraser"></i> Limpiar</button>
            <button type="submit" id="btnGuardarIngresoTaller" class="btn btn-cavex">
                <i class="bi bi-check2-circle" aria-hidden="true"></i>
                <span id="btnGuardarLabel">Registrar mantenimiento</span>
            </button>
        </div>
    </div>
</form>

<!-- ─── Tabla de historial ─────────────────────────────────────────────────── -->
<section class="cavex-card table-module vehiculo-module-table mant-history-card mt-4" aria-labelledby="tituloHistorialMantenimiento">
    <div class="mant-history-header">
        <div>
            <span class="mant-section-eyebrow">Seguimiento</span>
            <h2 class="form-section-title m-0" id="tituloHistorialMantenimiento">Historial de mantenimientos</h2>
            <p>Consulta los ingresos a taller y reportes finalizados.</p>
        </div>
        <span class="mant-count-badge"><i class="bi bi-wrench-adjustable-circle"></i><strong id="countMantenimientoActivo">0</strong> en mantenimiento</span>
    </div>

    <div class="mant-history-toolbar">
        <div class="table-search-box position-relative">
            <label class="visually-hidden" for="tableSearch">Buscar en el historial</label>
            <i class="bi bi-search mant-search-icon" aria-hidden="true"></i>
            <input type="search" id="tableSearch" class="form-control" placeholder="Buscar vehículo, taller o responsable..." autocomplete="off" />
        </div>
        <div class="custom-tabs-container" id="statusTabs" aria-label="Filtrar historial por estado">
            <button type="button" class="tab-item active" data-status-filter="todos">
                Todos <span class="tab-count count-all" id="countTodos">0</span>
            </button>
            <button type="button" class="tab-item" data-status-filter="incompletos">
                Tickets Incompletos <span class="tab-count count-inactive" id="countIncompletos">0</span>
            </button>
            <button type="button" class="tab-item" data-status-filter="completos">
                Reportes Completos <span class="tab-count count-active" id="countCompletos">0</span>
            </button>
        </div>
    </div>

    <div class="table-responsive mant-table-scroll">
        <table class="table table-hover align-middle executive-table table-cavex-compact">
            <thead>
                <tr>
                    <th>Vehículo</th>
                    <th>Taller</th>
                    <th>Tipo de Servicio</th>
                    <th>Encargado</th>
                    <th>Fecha de ingreso</th>
                    <th>Kilometraje</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th class="text-end" style="width:130px;">Acciones</th>
                </tr>
            </thead>
            <tbody id="ingresoTallerTableBody">
                <tr>
                    <td colspan="9" class="mant-table-state"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Cargando registros...</td>
                </tr>
            </tbody>
        </table>
    </div>
</section>
</div>

@section Scripts {
    <script src="~/js/vehiculos/servicios-vehiculos/vista-ingreso-taller.js" asp-append-version="true"></script>
}
